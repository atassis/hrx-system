{
  "version": 1,
  "cases": [
    {
      "name": "word and wide shifts preserve all result bits across count regimes on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {"tool": "generate-cases", "args": ["{tmp}/fixtures"]}
        },
        {
          "name": "target",
          "run": {"tool": "iree-xdna-run", "args": ["--print_target"]},
          "capture": "target"
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/testdata/integer_shifts.loom",
              "--root=@shift_packets",
              "--target=amd.xdna.aie2p:{target}",
              "--output={tmp}/shifts.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/shifts.xdna",
              "--columns=1",
              "--entry=shift_packets",
              "--invocation_count=1",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {"path": "{tmp}/input-readback.bin", "equals": "{tmp}/fixtures/input.bin"},
            {"path": "{tmp}/output-readback.bin", "equals": "{tmp}/fixtures/expected.bin"}
          ]
        }
      ]
    }
  ]
}
